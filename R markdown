# --- 0. Bibliothèques ---
library(ggplot2)
library(dplyr)
library(readr)
library(scales)

# --- 1. Lecture des données ---
data <- read_csv("data/dpe_final_lyon.csv", show_col_types = FALSE)

# Palette de couleurs par DPE
couleurs_dpe <- c(
  "A"="#00A75E","B"="#3BB040","C"="#94C742",
  "D"="#FFD100","E"="#FF8C00","F"="#F85C00","G"="#DC0000"
)

# --- 2. Graphique 1 : Consommation moyenne par DPE ---
dpe_stats <- data %>%
  group_by(dpe_classe) %>%
  summarise(Conso_moyenne = mean(consommation_kwh_m2, na.rm=TRUE)) %>%
  arrange(dpe_classe)

ggplot(dpe_stats, aes(x=dpe_classe, y=Conso_moyenne, fill=dpe_classe)) +
  geom_col(color="black") +
  geom_text(aes(label=round(Conso_moyenne,1)), vjust=-0.5) +
  scale_fill_manual(values=couleurs_dpe) +
  labs(title="Consommation moyenne par classe DPE", x="Classe DPE", y="Consommation (kWh/m²)") +
  theme_minimal(base_size=14) +
  theme(legend.position="none")

# --- 3. Graphique 2 : Répartition Ancien/Neuf par DPE ---
ancien_neuf <- data %>%
  group_by(dpe_classe, source_type) %>%
  summarise(N=n()) %>%
  ungroup() %>%
  group_by(dpe_classe) %>%
  mutate(Percent = N / sum(N) * 100)

ggplot(ancien_neuf, aes(x=dpe_classe, y=Percent, fill=source_type)) +
  geom_bar(stat="identity", position="stack", color="black") +
  scale_fill_manual(values=c("Ancien"="#FF8C00","Neuf"="#007bff")) +
  labs(title="Répartition Ancien/Neuf par classe DPE", x="Classe DPE", y="Pourcentage (%)", fill="Type logement") +
  theme_minimal(base_size=14)

# --- 4. Graphique 3 : Relation Surface ↔ Consommation ---
ggplot(data, aes(x=surface_m2, y=consommation_kwh_m2, color=dpe_classe)) +
  geom_point(alpha=0.6) +
  geom_smooth(method="lm", color="black") +
  scale_color_manual(values=couleurs_dpe) +
  labs(title="Relation Surface vs Consommation énergétique", x="Surface (m²)", y="Consommation (kWh/m²)", color="Classe DPE") +
  theme_minimal(base_size=14)

# --- 5. Graphique 4 : Boxplot consommation par DPE ---
ggplot(data, aes(x=dpe_classe, y=consommation_kwh_m2, fill=dpe_classe)) +
  geom_boxplot(outlier.shape=NA) +
  coord_cartesian(ylim=quantile(data$consommation_kwh_m2, c(0.05,0.95), na.rm=TRUE)) +
  scale_fill_manual(values=couleurs_dpe) +
  labs(title="Distribution des consommations par classe DPE", x="Classe DPE", y="Consommation (kWh/m²)") +
  theme_minimal(base_size=14) +
  theme(legend.position="none")
